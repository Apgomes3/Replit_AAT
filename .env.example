# Copy to .env and fill in. .env is git-ignored — never commit real values.

# PostgreSQL connection. `npm run setup` creates this database if it does not exist.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/shark_os

# Secret used to sign login tokens. Use a long random string (e.g. 48+ characters).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public base URL of the web app, used in password-reset links.
APP_URL=http://localhost:5000

NODE_ENV=development

# API port (the web dev server on 5000 proxies /api to it). Defaults to 3000.
# PORT=3000

# Email (optional in development: reset links are printed to the API console instead).
# Port 587 = STARTTLS, 465 = SSL.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
