{
  "name": "workspace",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,green\" \"tsx apps/api/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "setup": "node scripts/setup.cjs",
    "migrate": "tsx apps/api/src/db/migrate.ts",
    "seed": "tsx apps/api/src/db/seed.ts",
    "species:catalog:seed": "tsx apps/api/src/db/seedSpeciesCatalogCli.ts",
    "species:catalog:generate": "tsx apps/api/src/db/generateSpeciesCatalogArtifact.ts",
    "test:browser": "playwright test",
    "test:browser:follow": "FOLLOW_RECORD_E2E=1 PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=\"$(command -v chromium)\" playwright test apps/web/e2e/record-following.spec.ts --project=mobile-chromium",
    "test:browser:quotes": "QUOTE_PRODUCT_E2E=1 PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=\"$(command -v chromium)\" playwright test apps/web/e2e/enquiry-quote-products.spec.ts --project=mobile-chromium",
    "test:browser:mobile": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=\"$(command -v chromium)\" playwright test apps/web/e2e/lss-control-panel.mobile.spec.ts --project=mobile-chromium",
    "test": "vitest run",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "import:pricelist": "tsx apps/api/src/modules/pim-import/cli.ts",
    "import:planner": "tsx apps/api/src/modules/drafting/planner-import/cli.ts",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "2.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.0",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.6",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.0",
    "react-leaflet": "^5.0.0",
    "sanitize-html": "2.18.1",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.7.0",
    "clsx": "^2.0.0",
    "concurrently": "^9.0.0",
    "lucide-react": "^0.545.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^7.0.0",
    "reactflow": "^11.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
